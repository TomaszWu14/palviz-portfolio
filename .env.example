DJANGO_SECRET_KEY=YOUR_DJANGO_SECRET_KEY_HERE
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=YOUR_DJANGO_ALLOWED_HOSTS_HERE
APP_NAME=YOUR_APP_NAME_HERE
# Wariant wdrożenia (ta sama baza + kod, osobny deploy pod własną nazwą/domeną):
#   pusto = pełna platforma; "hu" = tylko Kontrola HU + Wydruk HU (aplikacja hali).
# Dla osobnej appki „Kontrola HU": GROOVE_VARIANT=hu  +  APP_NAME=GROOVE Kontrola HU
GROOVE_VARIANT=
# Dowolny zestaw modułów serwowanych przez tę instancję (nadpisuje GROOVE_VARIANT):
#   GROOVE_MODULES=kontrola_hu,wydruk_hu     (klucze: data_center,paletyzacja,transport,
#   magazyn,kontrola_hu,wydruk_hu,zadania,klienci,zaria). Puste = pełna platforma.
GROOVE_MODULES=
# Portal (jedna domena, wiele usług): dokąd linkować każdy moduł, gdy żyje na innej
# usłudze/subdomenie. Pary "klucz=url" po przecinku, np.:
#   GROOVE_MODULE_URLS=YOUR_GROOVE_MODULE_URLS_HERE
GROOVE_MODULE_URLS=
# ── SSO / Keycloak (OIDC) — opcjonalne; puste/false = logowanie hasłem jak dziś ──
# Po postawieniu Keycloak: OIDC_ENABLED=true, realm URL + dane klienta z Keycloak.
# Endpointy wyliczą się z OIDC_ISSUER (konwencja Keycloak). Mapowanie ról: w Keycloak dodaj
# „group membership" mapper do claim `groups` z nazwami = grupy GROOVE (Administratorzy, …).
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_RP_CLIENT_ID=YOUR_OIDC_RP_CLIENT_ID_HERE
OIDC_RP_CLIENT_SECRET=YOUR_OIDC_RP_CLIENT_SECRET_HERE
OIDC_ROLES_CLAIM=groups
# ── Źródło danych wzorcowych (Faza 3) ────────────────────────────────────────────
# Puste = czytaj z lokalnej bazy (monolit). Ustaw na API serwisu master-data, żeby
# produkty/klienci/HU szły przez HTTP: MASTER_DATA_URL=https://core.groove.example.com/api/v2
MASTER_DATA_URL=
MASTER_DATA_API_KEY=YOUR_MASTER_DATA_API_KEY_HERE
# Domena (ustaw w Coolify): DJANGO_ALLOWED_HOSTS, DJANGO_CSRF_TRUSTED_ORIGINS, SITE_BASE_URL
# ── TRWAŁOŚĆ DANYCH (SQLite) — bez tego każdy deploy KASUJE bazę i zdjęcia! ──────
# W Coolify: aplikacja → Storages → dodaj DWA persistent volumes:
#   /app/data       (baza SQLite; ustaw też env DB_PATH=/app/data/db.sqlite3)
#   /app/web/media  (zdjęcia HU i inne uploady)
# Alternatywa produkcyjna: DATABASE_URL=postgresql://... (baza poza kontenerem).
# UWAGA: ustawiaj tylko na serwerze — lokalnie (Windows/dev) zostaw puste (BASE_DIR/db.sqlite3).
# DB_PATH=/app/data/db.sqlite3
# Dev z lokalnym Postgresem z docker-compose (profil `pg`):
#   docker compose --profile pg up
#   DATABASE_URL=YOUR_DATABASE_URL_HERE
# Przełączenie PROD na Postgres: patrz docs/postgres-switch.md.
# TWA/APK (po przebudowie): TWA_PACKAGE_NAME=com.example.groove, TWA_SHA256_FINGERPRINT=<odcisk>
# ── ZARIA (wewnętrzny asystent AI) — opcjonalne; puste = moduł niewidoczny/nieaktywny ──
# Klucz dostawcy LLM — tylko po stronie serwera, nigdy nie trafia do przeglądarki.
# Katalog modeli, cennik, limity i prompt systemowy są edytowalne w panelu admina.
ZARIA_ANTHROPIC_API_KEY=YOUR_ZARIA_ANTHROPIC_API_KEY_HERE
ZARIA_OPENAI_API_KEY=YOUR_ZARIA_OPENAI_API_KEY_HERE
ZARIA_AZURE_OPENAI_API_KEY=YOUR_ZARIA_AZURE_OPENAI_API_KEY_HERE
ZARIA_AZURE_OPENAI_ENDPOINT=
ZARIA_DEFAULT_MODEL_KEY=YOUR_ZARIA_DEFAULT_MODEL_KEY_HERE
ZARIA_RATE_LIMIT_PER_MINUTE=20
ZARIA_RATE_LIMIT_PER_DAY=200
ZARIA_REQUEST_TIMEOUT_SEC=60
# Retry z backoffem dla 429/529/timeout (max prób po stronie SDK).
ZARIA_MAX_RETRIES=3
# true → zapisuj treść rozmów z /api/chat; domyślnie tylko ID + liczniki tokenów.
ZARIA_LOG_CONVERSATIONS=false
# Lokalny LLM (Ollama, endpoint zgodny z OpenAI), np. http://192.168.1.50:11434/v1
ZARIA_OLLAMA_BASE_URL=
# Kontakt "napisz do administratora" pokazywany w UI (np. brak dostępu do ZARII).
ADMIN_CONTACT_EMAIL=

# ── Moduł „Wysyłka UKRAINA" ──────────────────────────────────────────────────
# Kody warehouse_type (SAP LGNUM) rozdzielające magazyny na monitoringu partii.
# CSV — można podać kilka kodów na magazyn. Puste = stan trafia do kolumny „inne".
UKRAINE_WAREHOUSE_ACME=
UKRAINE_WAREHOUSE_DLT=
# Kontrola HU — strefa GLS: kody warehouse_type z obowiązkowym rozliczeniem
# kartony→paczki przy księgowaniu (raport konsolidacji). CSV, domyślnie "GLS".
GLS_ZONE_CODES=YOUR_GLS_ZONE_CODES_HERE

# ── Monitoring błędów (Sentry) — opcjonalne, mocno zalecane na produkcji ──
# Po ustawieniu DSN aplikacja od razu raportuje 500-tki ze stack trace (settings.py wpina
# to automatycznie). SENTRY_ENVIRONMENT rozdziela prod/staging. Release grupowany po git SHA
# (build-arg SOURCE_COMMIT z Coolify → GIT_SHA) — widać, który deploy wprowadził błąd.
SENTRY_DSN=YOUR_SENTRY_DSN_HERE
SENTRY_ENVIRONMENT=production

# Webhook kanalu Teams (Workflows "when a webhook request is received") - alerty
# regul pakowania i powiadomienia zespolowe. Puste = wylaczone.
TEAMS_WEBHOOK_URL=YOUR_TEAMS_WEBHOOK_URL_HERE
